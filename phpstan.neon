includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Temporary: no status enum uses this trait yet. The first one (Iteración 1) makes this
        # entry unmatched and PHPStan will fail until it is removed.
        -
            identifier: trait.unused
            path: app/Modules/Shared/Enums/Concerns/HasTransitions.php
